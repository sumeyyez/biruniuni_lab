import java.util.Scanner;

enum ShippingType {
    ECONOMY(0.8, 10),
    STANDARD(1.0, 20),
    EXPRESS(1.5, 40);

    private double multiplier;
    private double fixedFee;

    ShippingType(double multiplier, double fixedFee) {
        this.multiplier = multiplier;
        this.fixedFee = fixedFee;
    }

    public double getMultiplier() {
        return multiplier;
    }

    public double getFixedFee() {
        return fixedFee;
    }
}

class CargoShipment {
    private String customerName;
    private double weight;
    private double distance;
    private ShippingType shippingType;

    public CargoShipment(String customerName, double weight, double distance, ShippingType shippingType) {
        this.customerName = customerName;
        this.weight = weight;
        this.distance = distance;
        this.shippingType = shippingType;
    }

    public String getCustomerName() {
        return customerName;
    }

    public double getWeight() {
        return weight;
    }

    public double getDistance() {
        return distance;
    }

    public ShippingType getShippingType() {
        return shippingType;
    }

    public double calculateBaseFee() {
        double baseFee = (weight * 15) + (distance * 0.5);
        return baseFee;
    }

    public double calculateTotalFee() {
        double baseFee = calculateBaseFee();
        double totalFee = (baseFee * shippingType.getMultiplier()) + shippingType.getFixedFee();
        return totalFee;
    }

    public void displayInfo() {
        System.out.println("----- Shipment Info -----");
        System.out.println("Customer Name: " + customerName);
        System.out.println("Package Weight: " + weight + " kg");
        System.out.println("Shipping Distance: " + distance + " km");
        System.out.println("Shipping Type: " + shippingType);
        System.out.println("Base Shipping Fee: " + calculateBaseFee() + " TL");
        System.out.println("Total Shipping Fee: " + calculateTotalFee() + " TL");
    }
}

public class TestCargoShipment {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.println("Shipping Types:");
        System.out.println("1. ECONOMY  - Multiplier: 0.8 - Fixed Fee: 10 TL");
        System.out.println("2. STANDARD - Multiplier: 1.0 - Fixed Fee: 20 TL");
        System.out.println("3. EXPRESS  - Multiplier: 1.5 - Fixed Fee: 40 TL");

        System.out.print("Enter customer name: ");
        String name = input.nextLine();

        System.out.print("Enter package weight (kg): ");
        double weight = input.nextDouble();

        System.out.print("Enter shipping distance (km): ");
        double distance = input.nextDouble();

        System.out.print("Enter shipping type number (1-3): ");
        int typeNumber = input.nextInt();

        ShippingType type;
        if (typeNumber == 1) {
            type = ShippingType.ECONOMY;
        } else if (typeNumber == 2) {
            type = ShippingType.STANDARD;
        } else {
            type = ShippingType.EXPRESS;
        }

        CargoShipment shipment = new CargoShipment(name, weight, distance, type);
        shipment.displayInfo();

        input.close();
    }
}
